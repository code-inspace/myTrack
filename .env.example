# ==========================================================
# MyTrack Environment Configuration
# ==========================================================

# Supabase Database (PostgreSQL via Prisma & Direct)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth & Client
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# OneSignal Push Notifications
NEXT_PUBLIC_ONESIGNAL_APP_ID="your-onesignal-app-id"
ONESIGNAL_REST_API_KEY="your-onesignal-rest-api-key"

# AI Provider Configuration (OpenAI / Gemini / Anthropic)
# If not provided, MyTrack uses its built-in Heuristic Intelligence Coach
AI_PROVIDER="heuristic" # "heuristic" | "openai" | "gemini" | "anthropic"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini" # or "gemini-1.5-flash"

# App Public URL (For OneSignal webhooks & PWA links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
