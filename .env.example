# --------------------------------------------------
# Supabase Configuration
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# --------------------------------------------------
# AI Coach Configuration (Groq)
# --------------------------------------------------
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
# Model used to read photos of paper to-do lists (must accept images)
AI_VISION_MODEL=qwen/qwen3.8-27b
AI_API_KEY=gsk_your_groq_api_key_here

# --------------------------------------------------
# Push Notifications (OneSignal)
# --------------------------------------------------
NEXT_PUBLIC_ONESIGNAL_APP_ID=945a1ce4-1662-414e-9e72-9d014e9c3f5f
ONESIGNAL_REST_API_KEY=os_v2_app_your_onesignal_rest_api_key_here

# --------------------------------------------------
# Server-only secrets (never commit real values)
# --------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Signs the per-user tokens of the iOS widget (falls back to the service role key if unset)
WIDGET_TOKEN_SECRET=generate-a-long-random-string
